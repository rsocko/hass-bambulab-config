# Commit this file to enable or disable automatic deploy workflow dispatch on push.
# The push wrapper reads these values and dispatches deploy-homeassistant-template.yml
# with the matching workflow_dispatch inputs.

# Master switch. Keep false until you want commit-driven deploys.
AUTO_DEPLOY_ENABLED=true

# Optional branch filter. Comma-separated bash-style patterns.
# Examples: main,feature/print-history,feature/*
AUTO_DEPLOY_BRANCHES=main

# Workflow inputs.
AUTO_DEPLOY_DRY_RUN=false
AUTO_DEPLOY_DELETE_MODE=safe
AUTO_DEPLOY_ALLOWLIST_PROFILE=packages_www
AUTO_DEPLOY_ALLOWLIST_FILE=
AUTO_DEPLOY_PACKAGE_SCOPE=selected
AUTO_DEPLOY_SELECTED_PACKAGES=print_history,common,core
AUTO_DEPLOY_PACKAGE_PRESET=core_common
AUTO_DEPLOY_INCLUDE_WWW_FOR_SELECTED=true
AUTO_DEPLOY_CHECK_UI_NAME_CONFLICTS=true
AUTO_DEPLOY_DEBUG_DEPLOY_SYNC=false
AUTO_DEPLOY_FAIL_ON_UI_CONFLICT=false
AUTO_DEPLOY_POST_DEPLOY_ACTION=reload_domains_and_lovelace
AUTO_DEPLOY_RELOAD_DOMAINS_STRICT=false
AUTO_DEPLOY_RESOURCE_SAFETY_MODE=warn
AUTO_DEPLOY_FEATURE_INCLUDE_MODE=auto_update_include_file
AUTO_DEPLOY_HA_CONFIGURATION_YAML_PATH=/config/configuration.yaml
AUTO_DEPLOY_HA_FEATURE_INCLUDE_FILE_PATH=/config/packages/3d_printing/_feature_loaders.yaml
AUTO_DEPLOY_CONFIG_VALIDATION_MODE=smart
# Model Catalog Sidecar Environment Configuration
# Copy this file to .env and populate with your values

# ============================================================================
# Container & Deployment
# ============================================================================

# Docker image tag for the sidecar
MODEL_CATALOG_IMAGE_TAG=0.1.0

# Hostname for reverse proxy routing (Traefik)
MODEL_CATALOG_HOSTNAME=model-catalog.socko.us

# ============================================================================
# Asset Storage Configuration
# ============================================================================

# REQUIRED: Host path to bind mount for model assets, working groups, intake
# This path should be on your host machine (Windows, Linux, NAS, etc.)
#
# Windows OneDrive Example:
#   ASSETS_ROOT_HOST=/mnt/c/OneDrive/Documents/3D Models
#
# Windows Local Path Example:
#   ASSETS_ROOT_HOST=/mnt/d/ModelAssets
#
# NAS/Network Share Example (WSL):
#   ASSETS_ROOT_HOST=/mnt/nas/models
#
# Linux Local Path Example:
#   ASSETS_ROOT_HOST=/home/user/models
#
# The sidecar will organize this directory as:
#   /assets/
#   ├── catalog/       # Catalog models (local authority)
#   ├── working/       # Working groups (Phase 1.5+)
#   ├── inbox/         # Temporary upload staging (Phase 1.5+)
#   └── imported/      # Imported models from Manyfold (Phase 2+)
#
ASSETS_ROOT_HOST=/mnt/c/OneDrive/Documents/3D Models

# Model Catalog Assets Root (container path)
# Where all local model files, assets, and photos are stored (within the /assets bind mount).
# This path is visible and navigable on the host machine.
#
# Default behavior:
#   - If not set, defaults to /assets/Model Catalog
#   - All local models store their files here: {root}/{local_model_id}/{files}
#   - Includes model files, uploaded photos, and extracted assets
#
# Structure:
#   /assets/Model Catalog/
#   ├── model-a/
#   │   ├── model.3mf              # Main model file
#   │   ├── preview.jpg            # Preview image
#   │   ├── photo-abc123.jpg       # Uploaded photos
#   │   └── extracted/             # Optional: extracted assets from 3MF
#   │       └── layer-preview.png
#   └── model-b/
#       └── ...
#
# Catalog storage root. This is service-controlled published storage,
# not an operator intake/working browse source.
# Container paths only:
#   MODEL_CATALOG_CURATED_ASSETS_ROOT=/assets/Model Catalog
#   MODEL_CATALOG_CURATED_ASSETS_ROOT=/assets/catalog
MODEL_CATALOG_CURATED_ASSETS_ROOT=/assets/Model Catalog

# Optional profile-specific curated storage override for test.
# When set, this takes precedence over MODEL_CATALOG_CURATED_ASSETS_ROOT
# when the active DB profile is test.
# MODEL_CATALOG_CURATED_ASSETS_ROOT_TEST=/assets/Model Catalog Test

# Intake source roots. These are the only paths exposed to the intake browse/
# select workflow.
# Examples:
#   MODEL_CATALOG_INTAKE_ROOTS=/assets/Model Inbox
#   MODEL_CATALOG_INTAKE_ROOTS=/assets/Model Inbox,/assets/Imported Remotes
MODEL_CATALOG_INTAKE_ROOTS=/assets/Model Inbox

# Optional profile-specific intake source roots for test.
# MODEL_CATALOG_INTAKE_ROOTS_TEST=/assets/Model Inbox Test

# Working Files root. Working Files explorer, reindex, and reorganize destination
# resolve from this path.
MODEL_CATALOG_WORKING_FILES_ROOT=/assets/Model Working Files

# Optional profile-specific working files root for test.
# MODEL_CATALOG_WORKING_FILES_ROOT_TEST=/assets/Model Working Files Test

# ============================================================================
# Manyfold Integration (OPTIONAL)
# ============================================================================

# Base URL for Manyfold instance
# If you don't have Manyfold or want to run model-catalog standalone,
# you can leave this empty or point to a remote instance.
#
# Examples:
#   http://manyfold:3214                 (same Docker network)
#   http://192.168.1.100:3214            (another host)
#   http://manyfold.example.com          (remote)
#   (empty for standalone mode)
#
MANYFOLD_BASE_URL=http://manyfold:3214

# Manyfold API paths (defaults work for standard Manyfold)
MANYFOLD_MODELS_PATH=/models
MANYFOLD_COLLECTIONS_PATH=/collections
MANYFOLD_CREATORS_PATH=/creators
MANYFOLD_OAUTH_TOKEN_PATH=/oauth/token

# Manyfold OAuth credentials
# Create an OAuth application in Manyfold admin UI if integrating
# Leave empty if running standalone without Manyfold integration
MANYFOLD_CLIENT_ID=
MANYFOLD_CLIENT_SECRET=
MANYFOLD_OAUTH_SCOPES=public read

# Alternative: Manyfold Session Authentication (if OAuth is not set up)
# Leave empty if using OAuth above
MANYFOLD_SESSION_EMAIL=
MANYFOLD_SESSION_PASSWORD=

# ============================================================================
# Sidecar Configuration
# ============================================================================

# Model catalog cache refresh interval (seconds)
# How often to refresh the Manyfold model cache (if Manyfold is available)
MODEL_CATALOG_REFRESH_TTL_SECONDS=900

# Runtime authority mode for unified catalog endpoints.
# local    = sidecar SQLite is authoritative for /api/models and /api/models/search
# hybrid   = merge frozen Manyfold cache with local models for compatibility
# manyfold = legacy compatibility mode backed by Manyfold cache
MODEL_CATALOG_AUTHORITY_MODE=local

# Database profile controls.
# Use prod for live data, test for dev/validation data.
MODEL_CATALOG_DB_PROFILE=prod

# Base DB path used by prod profile.
MODEL_CATALOG_DB_PATH=/data/model_catalog.db

# Optional profile override for test DB path.
MODEL_CATALOG_DB_PATH_TEST=/data/model_catalog_test.db

# Keep schema migrations in sync on startup for both DBs.
MODEL_CATALOG_DB_BOOTSTRAP_ALL_PROFILES=true

# Optional one-time bootstrap copy from PROD -> TEST on startup.
# Leave false for normal operation. If true, set overwrite explicitly if needed.
MODEL_CATALOG_DB_SEED_TEST_FROM_PROD_ON_START=false
MODEL_CATALOG_DB_SEED_TEST_OVERWRITE=false

# Optional: Standalone mode
# Set to true to allow sidecar startup even if Manyfold is unavailable
MODEL_CATALOG_STANDALONE_MODE=true

# ============================================================================
# Deployment Notes
# ============================================================================

# GETTING STARTED:
#
# 1. Ensure ASSETS_ROOT_HOST points to an existing, writable directory
#    Example (Windows):
#      mkdir "C:\OneDrive\Documents\3D Models"
#
# 2. Ensure the 'traefik' Docker network exists:
#      docker network create traefik
#
# 3. If using Manyfold integration, set MANYFOLD_BASE_URL and credentials
#    Otherwise, leave blank for standalone operation
#
# 4. Start the stack:
#      docker compose up -d
#
# 5. Access the API:
#      http://localhost:8314
#      http://model-catalog.socko.us  (via Traefik if configured)

# STORAGE ORGANIZATION:
#
# The sidecar automatically organizes files in ASSETS_ROOT_HOST:
#
#   catalog/       - Catalog models (local authority)
#   working/       - Active projects in editing (Phase 1.5+)
#   inbox/         - Temporary staging for imports (Phase 1.5+)
#   imported/      - Models from external sources (Phase 2+)
#
# You can browse and organize these folders via your host OS.
# The sidecar DB (in Docker named volume) tracks all metadata.

# BACKUP STRATEGY:
#
# Two durable states to protect:
#
# 1. Database (named volume):
#      /data/model_catalog.db
#    Backup via: SQLite snapshot or Docker volume backup
#
# 2. Assets (bind mount):
#      {ASSETS_ROOT_HOST}/*
#    Backup via: Host-level backup (local copy, NAS, cloud sync, etc.)
#
# See docs/features/model_catalog/persistence-and-backup-strategy.md

# REQUIRED
# Repo URL for this runner registration (for org runner, set ORG_NAME and RUNNER_SCOPE=org)
REPO_URL=https://github.com/rsocko/hass-bambulab-config

# GitHub PAT (classic or fine-grained) that can register self-hosted runners.
# For repo runner: repo admin permissions on the target repository.
# For org runner: org admin permissions.
ACCESS_TOKEN=ghp_REPLACE_ME

# OPTIONAL
RUNNER_SCOPE=repo
ORG_NAME=
RUNNER_NAME=ha-dockhand-runner
LABELS=self-hosted,linux,docker,ha,homelab,dockhand
RUNNER_WORKDIR=_work
RUNNER_GROUP=Default
DISABLE_AUTO_UPDATE=false
EPHEMERAL=false

# REQUIRED (resolved by Dockhand variable substitution)
# Repo URL for this runner registration (for org runner, set ORG_NAME and RUNNER_SCOPE=org)
REPO_URL=${HA_GH_RUNNER_REPO_URL}

# GitHub PAT (classic or fine-grained) that can register self-hosted runners.
# For repo runner: repo admin permissions on the target repository.
# For org runner: org admin permissions.
ACCESS_TOKEN=${HA_GH_RUNNER_ACCESS_TOKEN}

# OPTIONAL (override in Dockhand/global vars only when needed)
RUNNER_CONTAINER_NAME=${HA_GH_RUNNER_CONTAINER_NAME:-github-runner-ha}
RUNNER_SCOPE=${HA_GH_RUNNER_SCOPE:-repo}
ORG_NAME=${HA_GH_RUNNER_ORG_NAME:-}
RUNNER_NAME=${HA_GH_RUNNER_NAME:-ha-dockhand-runner}
LABELS=${HA_GH_RUNNER_LABELS:-self-hosted,linux,docker,ha,homelab,dockhand}
RUNNER_WORKDIR=${HA_GH_RUNNER_WORKDIR:-_work}
RUNNER_GROUP=${HA_GH_RUNNER_GROUP:-Default}
DISABLE_AUTO_UPDATE=${HA_GH_RUNNER_DISABLE_AUTO_UPDATE:-false}
EPHEMERAL=${HA_GH_RUNNER_EPHEMERAL:-false}

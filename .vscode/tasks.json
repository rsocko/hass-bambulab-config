{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Validate Before Sync",
      "dependsOn": [
        "Run Lovelace Resource Cache-Bust Check"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Run Lovelace Resource Cache-Bust Check",
      "type": "shell",
      "command": "python",
      "args": [
        ".github/scripts/check_lovelace_resource_versions.py",
        "--manifest",
        "homeassistant/packages/3d_printing/common/dashboards/_resources.yaml",
        "--base-ref",
        "origin/main",
        "--mode",
        "fail"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "revealProblems": "onProblem",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": {
        "owner": "lovelace-resource-cache-bust",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    }
  ]
}
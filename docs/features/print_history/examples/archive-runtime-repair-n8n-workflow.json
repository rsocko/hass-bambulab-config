{
  "name": "Bambuddy Archive Runtime Repair",
  "nodes": [
    {
      "parameters": {
        "path": "bambuddy-archive-runtime-repair",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "id": "Webhook_Trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 240]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nif (!body.archive_id) { throw new Error('archive_id is required'); }\nreturn [{ json: body }];"
      },
      "id": "Validate_Request",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://bambuddy-runtime-repair:8080/admin/archive-runtime-repair",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.REPAIR_API_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  archive_id: $json.archive_id,\n  started_at: $json.started_at,\n  completed_at: $json.completed_at,\n  created_at: $json.created_at,\n  status: $json.status,\n  failure_reason: $json.failure_reason,\n  audit_note: $json.audit_note,\n  dry_run: false\n} }}"
      },
      "id": "Call_Sidecar",
      "name": "Call Sidecar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [770, 240]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: $json }];"
      },
      "id": "Parse_Result",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1030, 240]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}"
      },
      "id": "Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1270, 240]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{ "node": "Validate Request", "type": "main", "index": 0 }]]
    },
    "Validate Request": {
      "main": [[{ "node": "Call Sidecar", "type": "main", "index": 0 }]]
    },
    "Call Sidecar": {
      "main": [[{ "node": "Parse Result", "type": "main", "index": 0 }]]
    },
    "Parse Result": {
      "main": [[{ "node": "Respond", "type": "main", "index": 0 }]]
    }
  }
}
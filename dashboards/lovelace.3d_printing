                  }
                },
                {
                  "show_name": false,
                  "show_icon": true,
                  "type": "button",
                  "icon": "mdi:refresh-circle",
                  "name": "",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "automation.trigger",
                    "target": {
                      "entity_id": "automation.spoolman_location_sync"
                    },
                    "data": {
                      "skip_condition": true
                    }
                  },
                  "show_state": false,
                  "theme": "Metro Blue",
                  "card_mod": {
                    "style": "ha-card {\n  width: 70px;       /* icon-sized */\n  height: 55px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\nha-icon {\n  width: 48px;\n  height: 48px;\n}\n"
                  }
                }
              ]
            },
            {
              "type": "custom:config-template-card",
              "entities": [
                "sensor.selected_spool",
                "input_select.spool_location_choice"
              ],
              "variables": {
                "selected_entity": "states['sensor.selected_spool'].state",
                "spool_id": "states[states['sensor.selected_spool'].state].attributes.id",
                "new_location": "states['input_select.spool_location_choice'].state"
              },
              "card": {
                "type": "custom:bubble-card",
                "card_type": "button",
                "button_type": "name",
                "name": "${new_location}",
                "icon": "mdi:tray-arrow-down",
                "show_icon": true,
                "tap_action": {
                  "action": "call-service",
                  "service": "script.update_spool_location",
                  "service_data": {
                    "spool_id": "${spool_id}",
                    "location": "${new_location}"
                  }
                }
              }
            },
            {
              "type": "custom:bubble-card",
              "card_type": "separator",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "name": "Desiccant Container",
              "icon": "mdi:water-circle",
              "rows": "2"
            },
            {
              "type": "horizontal-stack",
              "cards": [
                {
                  "type": "custom:button-card",
                  "show_icon": true,
                  "show_name": false,
                  "show_label": true,
                  "tap_action": {
                    "action": "none"
                  },
                  "hold_action": {
                    "action": "none"
                  },
                  "double_tap_action": {
                    "action": "none"
                  },
                  "icon": "mdi:water",
                  "label": "[[[\n  const selected_entity = states['sensor.selected_spool'].state;\n  const spool_id = states[selected_entity].attributes.id;\n  const spool_entity = states[selected_entity];\n\n  const date = spool_entity?.attributes?.extra_desiccant_filled;\n  if (!date) return '\u2014';\n\n  const filled = new Date(date);\n  const now = new Date();\n  const days = Math.floor((now - filled) / 86400000);\n\n  let ago;\n  if (days < 7) ago = `${days}d ago`;\n  else if (days < 30) ago = `${Math.floor(days / 7)}w ago`;\n  else ago = `${Math.floor(days / 30)}mo ago`;\n\n  return `${filled.toLocaleDateString('en-US')} (${ago})`;\n]]]\n",
                  "styles": {
                    "grid": [
                      {
                        "grid-template-areas": "\"i\" \"l\""
                      },
                      {
                        "grid-template-rows": "min-content min-content"
                      },
                      {
                        "justify-items": "center"
                      },
                      {
                        "align-items": "center"
                      }
                    ],
                    "card": [
                      {
                        "background": "none"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "padding": "4px"
                      }
                    ],
                    "icon": [
                      {
                        "width": "25px"
                      },
                      {
                        "height": "25px"
                      },
                      {
                        "margin-bottom": "2px"
                      },
                      {
                        "color": "[[[\n  const selected_entity = states['sensor.selected_spool'].state;\n  const spool_id = states[selected_entity].attributes.id;\n  const spool_entity = states[selected_entity];\n\n  const date = spool_entity?.attributes?.extra_desiccant_filled;\n  if (!date) return 'gray';\n\n  const months = ((Date.now() - new Date(date)) / 86400000) / 30.437;\n  if (months > 2.5) return 'red';\n  if (months > 2.0) return 'orange';\n  if (months > 1.5) return 'yellow';\n  return 'green';\n]]]\n"
                      }
                    ],
                    "label": [
                      {
                        "font-size": "14px"
                      },
                      {
                        "text-align": "center"
                      },
                      {
                        "white-space": "nowrap"
                      }
                    ]
                  }
                },
                {
                  "type": "custom:button-card",
                  "icon": "mdi:clock-check-outline",
                  "label": "Mark as refilled",
                  "show_icon": true,
                  "show_name": false,
                  "show_label": true,
                  "tap_action": {
                    "action": "call-service",
                    "service": "script.refill_desiccant_update_date",
                    "service_data": {
                      "spool_id": "[[[\n  const selected_entity = states['sensor.selected_spool'].state;\n  const spool_id = states[selected_entity].attributes.id;\n  const spool_entity = states[selected_entity];\n\n  return spool_id;\n]]]\n"
                    }
                  },
                  "styles": {
                    "grid": [
                      {
                        "grid-template-areas": "\"i\" \"l\""
                      },
                      {
                        "grid-template-rows": "min-content min-content"
                      },
                      {
                        "justify-items": "center"
                      },
                      {
                        "align-items": "center"
                      }
                    ],
                    "card": [
                      {
                        "border": "1px solid rgba(0,0,0,0.15)"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "padding": "4px"
                      }
                    ],
                    "icon": [
                      {
                        "width": "25px"
                      },
                      {
                        "height": "25px"

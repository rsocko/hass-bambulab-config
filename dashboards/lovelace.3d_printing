        variables:
          selected_entity: states['sensor.selected_spool'].state
          spool_id: states[states['sensor.selected_spool'].state].attributes.id
          new_location: states['input_select.spool_location_choice'].state
        card:
          type: custom:bubble-card
          card_type: button
          button_type: name
          name: ${new_location}
          icon: mdi:tray-arrow-down
          show_icon: true
          tap_action:
            action: call-service
            service: script.update_spool_location
            service_data:
              spool_id: ${spool_id}
              location: ${new_location}
      - type: custom:bubble-card
        card_type: separator
        sub_button:
          main: []
          bottom: []
        name: Desiccant Container
        icon: mdi:water-circle
        rows: '2'
      - type: horizontal-stack
        cards:
          - type: custom:button-card
            show_icon: true
            show_name: false
            show_label: true
            tap_action:
              action: none
            hold_action:
              action: none
            double_tap_action:
              action: none
            icon: mdi:water
            label: |
              [[[
                const selected_entity = states['sensor.selected_spool'].state;
                const spool_id = states[selected_entity].attributes.id;
                const spool_entity = states[selected_entity];

                const date = spool_entity?.attributes?.extra_desiccant_filled;
                if (!date) return '—';

                const filled = new Date(date);
                const now = new Date();
                const days = Math.floor((now - filled) / 86400000);

                let ago;
                if (days < 7) ago = `${days}d ago`;
                else if (days < 30) ago = `${Math.floor(days / 7)}w ago`;
                else ago = `${Math.floor(days / 30)}mo ago`;

                return `${filled.toLocaleDateString('en-US')} (${ago})`;
              ]]]
            styles:
              grid:
                - grid-template-areas: '"i" "l"'
                - grid-template-rows: min-content min-content
                - justify-items: center
                - align-items: center
              card:
                - background: none
                - box-shadow: none
                - padding: 4px
              icon:
                - width: 25px
                - height: 25px
                - margin-bottom: 2px
                - color: |
                    [[[
                      const selected_entity = states['sensor.selected_spool'].state;
                      const spool_id = states[selected_entity].attributes.id;
                      const spool_entity = states[selected_entity];

                      const date = spool_entity?.attributes?.extra_desiccant_filled;
                      if (!date) return 'gray';

                      const months = ((Date.now() - new Date(date)) / 86400000) / 30.437;
                      if (months > 2.5) return 'red';
                      if (months > 2.0) return 'orange';
                      if (months > 1.5) return 'yellow';
                      return 'green';
                    ]]]
              label:
                - font-size: 14px
                - text-align: center
                - white-space: nowrap
          - type: custom:button-card
            icon: mdi:clock-check-outline
            label: Mark as refilled
            show_icon: true
            show_name: false
            show_label: true
            tap_action:
              action: call-service
              service: script.refill_desiccant_update_date
              service_data:
                spool_id: |
                  [[[
                    const selected_entity = states['sensor.selected_spool'].state;
                    const spool_id = states[selected_entity].attributes.id;
                    const spool_entity = states[selected_entity];

                    return spool_id;
                  ]]]
            styles:
              grid:
                - grid-template-areas: '"i" "l"'
                - grid-template-rows: min-content min-content
                - justify-items: center
                - align-items: center
              card:
                - border: 1px solid rgba(0,0,0,0.15)
                - box-shadow: none
                - padding: 4px
              icon:
                - width: 25px
                - height: 25px
                - margin-bottom: 2px
              label:
                - font-size: 14px
                - font-weight: bold
                - text-align: center
                - white-space: nowrap
      - type: horizontal-stack
        cards:
          - type: custom:button-card
            show_icon: true
            show_name: false
            show_label: true
            tap_action:
              action: none
            hold_action:
              action: none
            double_tap_action:
              action: none
            icon: mdi:heat-wave
            label: |
              [[[
                const selected_entity = states['sensor.selected_spool'].state;
                const spool_entity = states[selected_entity];

                const date = spool_entity?.attributes?.extra_last_dried;
                if (!date) return '—';

                const dried = new Date(date);
                const now = new Date();
                const days = Math.floor((now - dried) / 86400000);

                let ago;
                if (days < 7) ago = `${days}d ago`;
                else if (days < 30) ago = `${Math.floor(days / 7)}w ago`;
                else ago = `${Math.floor(days / 30)}mo ago`;

                return `${dried.toLocaleDateString('en-US')} (${ago})`;
              ]]]
            styles:
              grid:
                - grid-template-areas: '"i" "l"'
                - grid-template-rows: min-content min-content
                - justify-items: center
                - align-items: center
              card:
                - background: none
                - box-shadow: none
                - padding: 4px
              icon:
                - width: 25px
                - height: 25px
                - margin-bottom: 2px
                - color: |
                    [[[
                      const selected_entity = states['sensor.selected_spool'].state;
                      const spool_entity = states[selected_entity];

                      const date = spool_entity?.attributes?.extra_last_dried;
                      if (!date) return 'gray';

                      const months = ((Date.now() - new Date(date)) / 86400000) / 30.437;
                      if (months > 6) return 'red';
                      if (months > 3) return 'orange';
                      return 'green';
                    ]]]
              label:
                - font-size: 14px
                - text-align: center
                - white-space: nowrap
          - type: custom:button-card
            icon: mdi:heat-wave
            label: Mark as Dried
            show_icon: true
            show_name: false
            show_label: true
            tap_action:
              action: call-service
              service: script.mark_spool_as_dried
              service_data:
                spool_id: |
                  [[[
                    const selected_entity = states['sensor.selected_spool'].state;
                    const spool_id = states[selected_entity].attributes.id;

                    return spool_id;
                  ]]]
            styles:
              grid:
                - grid-template-areas: '"i" "l"'
                - grid-template-rows: min-content min-content
                - justify-items: center
                - align-items: center
              card:
                - border: 1px solid rgba(0,0,0,0.15)
                - box-shadow: none
                - padding: 4px
              icon:
                - width: 25px
                - height: 25px
                - margin-bottom: 2px
              label:
                - font-size: 14px
                - font-weight: bold
                - text-align: center
                - white-space: nowrap
      - type: custom:bubble-card
        card_type: separator
        sub_button:
          main: []
          bottom: []
        name: Other Actions
        icon: mdi:gesture-tap
      - type: custom:config-template-card

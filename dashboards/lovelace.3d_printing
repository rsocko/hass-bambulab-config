                                    "font-weight": "bold"
                                  },
                                  {
                                    "justify-self": "center"
                                  }
                                ]
                              }
                            },
                            {
                              "type": "custom:button-card",
                              "entity": "[[[\n  const tray = 'external_spool';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  const spoolId = map?.[tray]?.spool_id;\n\n  return spoolId\n    ? `sensor.spoolman_spool_${spoolId}`\n    : 'sensor.ntk_ryansoffice_3dprinter_external_spool';\n]]]\n",
                              "name": "[[[\n  const tray = 'external_spool';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  return map?.[tray]?.name ?? 'EMPTY';\n]]]\n",
                              "show_state": false,
                              "show_icon": false,
                              "tap_action": "[[[\n  const tray = 'external_spool';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  const spoolId = map?.[tray]?.spool_id;\n\n  return spoolId\n    ? { action: 'more-info', entity: `sensor.spoolman_spool_${spoolId}` }\n    : { action: 'none' };\n]]]\n",
                              "custom_fields": {
                                "desiccant_icon": "[[[\n  const tray = 'external_spool';\n  const status = states['sensor.spoolman_tray_map']?.attributes?.tray_map?.[tray]?.status;\n\n  // Hide droplet for green OR empty trays\n  if (status === 'green' || status === 'empty') return '';\n\n  const colors = {\n    undefined: '#9e9e9e',\n    yellow: '#ffcc00',\n    orange: '#ff9900',\n    red: '#cc0000'\n  };\n  \n  const color = colors[status] || '#9e9e9e';\n  return `<ha-icon icon=\"mdi:water\" style=\"--mdc-icon-size: 16px; color: ${color};\"></ha-icon>`;\n]]]\n",
                                "remaining_weight": "[[[\n  const tray = 'external_spool';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  const spoolId = map?.[tray]?.spool_id;\n  \n  if (!spoolId) return '';\n  \n  const entity = states[`sensor.spoolman_spool_${spoolId}`];\n  const weight = entity?.attributes?.remaining_weight;\n  \n  if (weight === undefined || weight === null) return '';\n  \n  return `<span style=\"font-size: 10px; color: #888;\">${Math.round(weight)}g</span>`;\n]]]\n",
                                "placeholder": "[[[\n  return '';\n]]]\n"
                              },
                              "styles": {
                                "card": [
                                  {
                                    "padding": "6px"
                                  },
                                  {
                                    "background": "none"
                                  },
                                  {
                                    "box-shadow": "none"
                                  }
                                ],
                                "grid": [
                                  {
                                    "grid-template-areas": "\"n\" \"desiccant_icon remaining_weight placeholder\""

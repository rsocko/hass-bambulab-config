            <div style="text-align:right;line-height:1.4;flex:1;">
              <div style="font-size:11px;font-weight:400;opacity:0.55;">3D Printer</div>
              <div style="font-size:22px;font-weight:700;">{{ states('sensor.ntk_ryansoffice_3dprinter_printer_name') | default('Unknown') }}</div>

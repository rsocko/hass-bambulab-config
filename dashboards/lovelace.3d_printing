{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.3d_printing",
  "data": {
    "config": {
      "views": [
        {
          "title": "Home",
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "conditional",
                  "conditions": [
                    {
                      "entity": "binary_sensor.ntk_ryansoffice_3dprinter_hms_errors",
                      "state": "on"
                    }
                  ],
                  "card": {
                    "type": "vertical-stack",
                    "cards": [
                      {
                        "type": "custom:mushroom-template-card",
                        "primary": "⚠️ HMS ERROR ALERT",
                        "secondary": "{{ states('binary_sensor.ntk_ryansoffice_3dprinter_hms_errors') | title }} - {{ state_attr('binary_sensor.ntk_ryansoffice_3dprinter_hms_errors', 'count') | int }} Error(s)",
                        "icon": "mdi:alert-circle",
                        "icon_color": "red",
                        "fill_container": false,
                        "tap_action": {
                          "action": "more-info"
                        },
                        "card_mod": {
                          "style": ": |\n  ha-card {\n    background: rgba(244, 67, 54, 0.15);\n    border: 2px solid var(--red-color);\n    --card-mod-icon-color: red;\n  }"
                        }
                      },
                      {
                        "type": "markdown",
                        "content": "{% set errors = state_attr('binary_sensor.ntk_ryansoffice_3dprinter_hms_errors', 'errors') %}\n{% if errors %}\n{% for error in errors %}\n**Error {{ loop.index }}:** {{ error.attr }}\n\n**Code:** {{ error.code }}\n\n{{ error.text }}\n\n---\n{% endfor %}\n{% else %}\nNo error details available\n{% endif %}",
                        "card_mod": {
                          "style": ": |\n  ha-card {\n    background: rgba(244, 67, 54, 0.08);\n    border-left: 4px solid var(--red-color);\n  }"
                        }
                      }
                    ]
                  },
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ],
              "column_span": 3
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:bubble-card",
                  "card_type": "button",
                  "button_type": "state",
                  "entity": "sensor.ntk_ryansoffice_3dprinter_print_status",
                  "name": "Print Status",
                  "icon": "mdi:rotate-3d",
                  "show_state": true,
                  "show_attribute": false,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "styles": "\n              .bubble-button-card-container {\n                background: var(--ha-card-background);\n              }\n              .bubble-name {\n                font-size: 18px !important;\n                font-weight: 600;\n              }\n              .bubble-state {\n                font-size: 16px !important;\n              }\n            "
                },
                {
                  "type": "custom:bubble-card",
                  "card_type": "button",
                  "button_type": "state",
                  "entity": "sensor.ntk_ryansoffice_3dprinter_current_stage",
                  "name": "Current Stage",
                  "icon": "mdi:printer-3d",
                  "show_state": true,
                  "show_attribute": false,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "styles": "\n              .bubble-button-card-container {\n                background: var(--ha-card-background);\n              }\n              .bubble-name {\n                font-size: 18px !important;\n                font-weight: 600;\n              }\n              .bubble-state {\n                font-size: 16px !important;\n              }\n            "
                },
                {
                  "type": "custom:bubble-card",
                  "card_type": "button",
                  "button_type": "state",
                  "entity": "sensor.ntk_ryansoffice_3dprinter_task_name",
                  "name": "Task Name",
                  "icon": "mdi:cube-outline",
                  "show_state": true,
                  "show_attribute": false,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "styles": "\n              .bubble-button-card-container {\n                background: var(--ha-card-background);\n              }\n              .bubble-name {\n                font-size: 18px !important;\n                font-weight: 600;\n              }\n              .bubble-state {\n                font-size: 16px !important;\n              }\n            "
                },
                {
                  "type": "custom:bubble-card",
                  "card_type": "button",
                  "button_type": "state",
                  "entity": "binary_sensor.ntk_ryansoffice_3dprinter_hms_errors",
                  "name": "HMS Errors",
                  "show_state": true,
                  "show_attribute": false,
                  "tap_action": {
                    "action": "more-info"
                  },
                  "styles": "\n              .bubble-button-card-container {\n                background: var(--ha-card-background);\n              }\n              .bubble-name {\n                font-size: 18px !important;\n                font-weight: 600;\n              }\n              .bubble-state {\n                font-size: 16px !important;\n              }\n            "
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.print_layer_progress_formatted",
                  "primary": "Layer Progress",
                  "secondary": "{{ states('sensor.print_layer_progress_formatted') }}",
                  "icon": "fas:layer-group",
                  "icon_color": "blue",
                  "layout": "vertical",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "card_mod": {
                    "style": "\n                  ha-card {\n                    font-size: 16px;\n                  }\n                  .primary {\n                    font-size: 18px !important;\n                    font-weight: 600;\n                  }\n                  .secondary {\n                    font-size: 22px !important;\n                    font-weight: 700;\n                  }\n                "
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.ntk_ryansoffice_3dprinter_print_progress",
                  "primary": "Print Progress",
                  "secondary": "{{ states('sensor.ntk_ryansoffice_3dprinter_print_progress') }}",
                  "icon": "mdi:progress-helper",
                  "icon_color": "green",
                  "layout": "vertical",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "card_mod": {
                    "style": "\n                  ha-card {\n                    font-size: 16px;\n                  }\n                  .primary {\n                    font-size: 18px !important;\n                    font-weight: 600;\n                  }\n                  .secondary {\n                    font-size: 22px !important;\n                    font-weight: 700;\n                  }\n                "
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "entity": "sensor.print_time_remaining_formatted",
                  "primary": "Time Remaining",
                  "secondary": "{{ states('sensor.print_time_remaining_formatted') }}",
                  "icon": "mdi:progress-clock",
                  "icon_color": "orange",
                  "layout": "vertical",
                  "tap_action": {
                    "action": "more-info"
                  },
                  "card_mod": {
                    "style": "\n                  ha-card {\n                    font-size: 16px;\n                  }\n                  .primary {\n                    font-size: 18px !important;\n                    font-weight: 600;\n                  }\n                  .secondary {\n                    font-size: 22px !important;\n                    font-weight: 700;\n                  }\n                "
                  }
                },
                {
                  "type": "custom:config-template-card",
                  "entities": [
                    "sensor.ntk_ryansoffice_3dprinter_end_time"
                  ],
                  "card": {
                    "type": "custom:mushroom-template-card",
                    "entity": "sensor.ntk_ryansoffice_3dprinter_end_time",
                    "primary": "Est. Completion",
                    "secondary": "{% set state = states('sensor.ntk_ryansoffice_3dprinter_end_time') %}{% if state not in ['unavailable', 'unknown'] and state is not none %}{{ as_timestamp(state) | timestamp_custom('%I:%M %p', true) }}{% else %}N/A{% endif %}",
                    "icon": "mdi:clock-end",
                    "icon_color": "purple",
                    "layout": "vertical",
                    "tap_action": {
                      "action": "more-info"
                    },
                    "card_mod": {
                      "style": "\n                      ha-card {\n                        font-size: 16px;\n                      }\n                      .primary {\n                        font-size: 18px !important;\n                        font-weight: 600;\n                      }\n                      .secondary {\n                        font-size: 22px !important;\n                        font-weight: 700;\n                      }\n                    "
                    }
                  }
                }
              ],
              "columns": 2,
              "square": false
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:ha-bambulab-print_status-card",
                  "printer": "210dfdfa64085e8cf073e50eae757d90",
                  "style": "simple",
                  "custom_power": "switch.sonoff_10018b4baf"
                },
                {
                  "type": "custom:advanced-camera-card",
                  "cameras": [
                    {
                      "camera_entity": "camera.ntk_ryansoffice_3dprinter_camera",
                      "live_provider": "auto",
                      "capabilities": {
                        "disable": []
                      },
                      "always_error_if_entity_unavailable": false,
                      "image": {
                        "mode": "camera"
                      }
                    },
                    {
                      "camera_entity": "camera.3dprintertopcamera_hd_stream"
                    }
                  ],
                  "status_bar": {
                    "items": {
                      "engine": {
                        "enabled": true
                      },
                      "resolution": {
                        "enabled": true
                      }
                    },
                    "style": "none"
                  },
                  "performance": {
                    "features": {
                      "card_loading_effects": false,
                      "animated_progress_indicator": true,
                      "card_loading_indicator": true
                    },
                    "style": {
                      "border_radius": true
                    }
                  },
                  "view": {
                    "dim": false,
                    "theme": {
                      "themes": [
                        "dark"
                      ]
                    },
                    "default_cycle_camera": false
                  },
                  "menu": {
                    "buttons": {
                      "iris": {
                        "enabled": false
                      },
                      "camera_ui": {
                        "enabled": false
                      },
                      "expand": {
                        "enabled": true
                      },
                      "display_mode": {
                        "enabled": true,
                        "alignment": "opposing"
                      },
                      "live": {
                        "enabled": false
                      },
                      "cameras": {
                        "enabled": false
                      },
                      "substreams": {
                        "enabled": false
                      },
                      "clips": {
                        "enabled": false
                      },
                      "snapshots": {
                        "enabled": false
                      },
                      "download": {
                        "enabled": false
                      },
                      "timeline": {
                        "enabled": false
                      },
                      "folders": {
                        "enabled": false
                      },
                      "media_player": {
                        "enabled": false
                      },
                      "image": {
                        "enabled": false
                      }
                    },
                    "style": "overlay",
                    "alignment": "right"
                  },
                  "live": {
                    "draggable": true,
                    "zoomable": true,
                    "show_image_during_load": true,
                    "controls": {
                      "builtin": true,
                      "wheel": true
                    },
                    "display": {}
                  },
                  "media_gallery": {
                    "controls": {
                      "thumbnails": {
                        "size": 228
                      }
                    }
                  }
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.ntk_ryansoffice_3dprinter_nozzle_temperature",
                      "primary": "{% set current = states('sensor.ntk_ryansoffice_3dprinter_nozzle_temperature') | float(0) %} {{ current | round(0) }}°C",
                      "secondary": "{% set target = states('sensor.ntk_ryansoffice_3dprinter_nozzle_target_temperature') | float(0) %} {{ target | round(0) }}°C",
                      "icon": "mdi:printer-3d-nozzle-heat",
                      "icon_color": "{% set current = states('sensor.ntk_ryansoffice_3dprinter_nozzle_temperature') | float(0) %} {% set target = states('sensor.ntk_ryansoffice_3dprinter_nozzle_target_temperature') | float(0) %} {% set printer_status = states('sensor.ntk_ryansoffice_3dprinter_print_status') | lower %} {% if printer_status == 'idle' or target == 0 %}\n  grey\n{% elif target > current + 2 %}\n  red\n{% elif target < current - 2 %}\n  blue\n{% else %}\n  #A24C63\n{% endif %}",
                      "layout": "horizontal",
                      "tap_action": {
                        "action": "more-info"
                      },
                      "card_mod": {
                        "style": "ha-card {\n  {% set current = states('sensor.ntk_ryansoffice_3dprinter_nozzle_temperature') | float(0) %}\n  {% set target = states('sensor.ntk_ryansoffice_3dprinter_nozzle_target_temperature') | float(0) %}\n  {% set printer_status = states('sensor.ntk_ryansoffice_3dprinter_print_status') | lower %}\n  {% if printer_status != 'idle' and target > 0 %}\n    {% if current < 50 %}\n      background: rgba(255, 235, 59, 0.08);\n      border-left: 3px solid rgba(255, 235, 59, 0.6);\n    {% elif current < 150 %}\n      background: rgba(255, 193, 7, 0.10);\n      border-left: 3px solid rgba(255, 193, 7, 0.7);\n    {% elif current < 220 %}\n      background: rgba(255, 152, 0, 0.12);\n      border-left: 3px solid rgba(255, 152, 0, 0.8);\n    {% else %}\n      background: rgba(244, 67, 54, 0.12);\n      border-left: 3px solid rgba(244, 67, 54, 0.8);\n    {% endif %}\n  {% else %}\n    background: rgba(158, 158, 158, 0.05);\n  {% endif %}\n}\n.primary {\n  font-size: 14px !important;\n  {% set target = states('sensor.ntk_ryansoffice_3dprinter_nozzle_target_temperature') | float(0) %}\n  {% if target > 0 %}\n    font-weight: 700;\n    opacity: 0.9;\n  {% else %}\n    font-weight: 500;\n    opacity: 0.7;\n  {% endif %}\n}\n.secondary {\n  font-size: 28px !important;\n  font-weight: 700;\n  {% set current = states('sensor.ntk_ryansoffice_3dprinter_nozzle_temperature') | float(0) %}\n  {% set target = states('sensor.ntk_ryansoffice_3dprinter_nozzle_target_temperature') | float(0) %}\n  {% set printer_status = states('sensor.ntk_ryansoffice_3dprinter_print_status') | lower %}\n  {% if printer_status == 'idle' or target == 0 %}\n    color: rgb(158, 158, 158) !important;\n  {% elif target > current + 2 %}\n    color: rgb(244, 67, 54) !important;\n  {% elif target < current - 2 %}\n    color: rgb(33, 150, 243) !important;\n  {% else %}\n    color: rgb(156, 39, 176) !important;\n  {% endif %}\n}\n"
                      }
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "sensor.ntk_ryansoffice_3dprinter_bed_temperature",
                      "primary": "{% set current = states('sensor.ntk_ryansoffice_3dprinter_bed_temperature') | float(0) %} {{ current | round(0) }}°C",
                      "secondary": "{% set target = states('sensor.ntk_ryansoffice_3dprinter_bed_target_temperature') | float(0) %} {{ target | round(0) }}°C",
                      "icon": "mdi:radiator",
                      "icon_color": "{% set current = states('sensor.ntk_ryansoffice_3dprinter_bed_temperature') | float(0) %} {% set target = states('sensor.ntk_ryansoffice_3dprinter_bed_target_temperature') | float(0) %} {% set printer_status = states('sensor.ntk_ryansoffice_3dprinter_print_status') | lower %} {% if printer_status == 'idle' or target == 0 %}\n  grey\n{% elif target > current + 2 %}\n  red\n{% elif target < current - 2 %}\n  blue\n{% else %}\n  #A24C63\n{% endif %}",
                      "layout": "horizontal",
                      "tap_action": {
                        "action": "more-info"
                      },
                      "card_mod": {
                        "style": "ha-card {\n  {% set current = states('sensor.ntk_ryansoffice_3dprinter_bed_temperature') | float(0) %}\n  {% set target = states('sensor.ntk_ryansoffice_3dprinter_bed_target_temperature') | float(0) %}\n  {% set printer_status = states('sensor.ntk_ryansoffice_3dprinter_print_status') | lower %}\n  {% if printer_status != 'idle' and target > 0 %}\n    {% if current < 30 %}\n      background: rgba(255, 235, 59, 0.08);\n      border-left: 3px solid rgba(255, 235, 59, 0.6);\n    {% elif current < 50 %}\n      background: rgba(255, 193, 7, 0.10);\n      border-left: 3px solid rgba(255, 193, 7, 0.7);\n    {% elif current < 80 %}\n      background: rgba(255, 152, 0, 0.12);\n      border-left: 3px solid rgba(255, 152, 0, 0.8);\n    {% else %}\n      background: rgba(244, 67, 54, 0.12);\n      border-left: 3px solid rgba(244, 67, 54, 0.8);\n    {% endif %}\n  {% else %}\n    background: rgba(158, 158, 158, 0.05);\n  {% endif %}\n}\n.primary {\n  font-size: 14px !important;\n  {% set target = states('sensor.ntk_ryansoffice_3dprinter_bed_target_temperature') | float(0) %}\n  {% if target > 0 %}\n    font-weight: 700;\n    opacity: 0.9;\n  {% else %}\n    font-weight: 500;\n    opacity: 0.7;\n  {% endif %}\n}\n.secondary {\n  font-size: 28px !important;\n  font-weight: 700;\n  {% set current = states('sensor.ntk_ryansoffice_3dprinter_bed_temperature') | float(0) %}\n  {% set target = states('sensor.ntk_ryansoffice_3dprinter_bed_target_temperature') | float(0) %}\n  {% set printer_status = states('sensor.ntk_ryansoffice_3dprinter_print_status') | lower %}\n  {% if printer_status == 'idle' or target == 0 %}\n    color: rgb(158, 158, 158) !important;\n  {% elif target > current + 2 %}\n    color: rgb(244, 67, 54) !important;\n  {% elif target < current - 2 %}\n    color: rgb(33, 150, 243) !important;\n  {% else %}\n    color: rgb(156, 39, 176) !important;\n  {% endif %}\n}\n"
                      }
                    }
                  ]
                },
                {
                  "type": "horizontal-stack",
                  "cards": [
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "fan.ntk_ryansoffice_3dprinter_aux_fan",
                      "primary": "{{ states('sensor.ntk_ryansoffice_3dprinter_aux_fan_speed') | int(0) }}%",
                      "secondary": "Aux",
                      "icon": "mdi:fan",
                      "badge_icon": "mdi:alpha-a-circle",
                      "badge_color": "{% set s = states('sensor.ntk_ryansoffice_3dprinter_aux_fan_speed') | int(0) %} {% if s == 0 %}grey{% elif s < 30 %}blue{% elif s < 70 %}amber{% else %}red{% endif %}",
                      "icon_color": "{% set s = states('sensor.ntk_ryansoffice_3dprinter_aux_fan_speed') | int(0) %} {% if s == 0 %}grey{% elif s < 30 %}blue{% elif s < 70 %}amber{% else %}red{% endif %}",
                      "layout": "vertical",
                      "fill": false,
                      "multiline_secondary": false,
                      "tap_action": {
                        "action": "more-info",
                        "entity": "fan.ntk_ryansoffice_3dprinter_aux_fan"
                      },
                      "hold_action": {
                        "action": "more-info",
                        "entity": "sensor.ntk_ryansoffice_3dprinter_aux_fan_speed"
                      },
                      "card_mod": {
                        "style": "ha-card {\n  padding: 4px 4px !important;\n  background: transparent;\n  border-radius: 12px;\n  transition: background 0.2s;\n  --icon-size: 28px;\n  --card-primary-font-size: 1.1rem;\n  --card-primary-font-weight: bold;\n  --card-secondary-font-size: 0.65rem;\n}\nha-card:hover {\n  background: rgba(var(--rgb-primary-text-color), 0.05);\n}\nmushroom-state-info {\n  text-align: center;\n  --card-secondary-letter-spacing: 0.5px;\n}\n"
                      }
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "fan.ntk_ryansoffice_3dprinter_chamber_fan",
                      "primary": "{{ states('sensor.ntk_ryansoffice_3dprinter_chamber_fan_speed') | int(0) }}%",
                      "secondary": "Chamber",
                      "icon": "mdi:fan-chevron-up",
                      "badge_icon": "mdi:cube-outline",
                      "badge_color": "{% set s = states('sensor.ntk_ryansoffice_3dprinter_chamber_fan_speed') | int(0) %} {% if s == 0 %}grey{% elif s < 30 %}blue{% elif s < 70 %}amber{% else %}red{% endif %}",
                      "icon_color": "{% set s = states('sensor.ntk_ryansoffice_3dprinter_chamber_fan_speed') | int(0) %} {% if s == 0 %}grey{% elif s < 30 %}blue{% elif s < 70 %}amber{% else %}red{% endif %}",
                      "layout": "vertical",
                      "fill": false,
                      "multiline_secondary": false,
                      "tap_action": {
                        "action": "more-info",
                        "entity": "fan.ntk_ryansoffice_3dprinter_chamber_fan"
                      },
                      "hold_action": {
                        "action": "more-info",
                        "entity": "sensor.ntk_ryansoffice_3dprinter_chamber_fan_speed"
                      },
                      "card_mod": {
                        "style": "ha-card {\n  padding: 4px 4px !important;\n  background: transparent;\n  border-radius: 12px;\n  transition: background 0.2s;\n  --icon-size: 28px;\n  --card-primary-font-size: 1.1rem;\n  --card-primary-font-weight: bold;\n  --card-secondary-font-size: 0.65rem;\n}\nha-card:hover {\n  background: rgba(var(--rgb-primary-text-color), 0.05);\n}\nmushroom-state-info {\n  text-align: center;\n  --card-secondary-letter-spacing: 0.5px;\n}\n"
                      }
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "fan.ntk_ryansoffice_3dprinter_cooling_fan",
                      "primary": "{{ states('sensor.ntk_ryansoffice_3dprinter_cooling_fan_speed') | int(0) }}%",
                      "secondary": "Cooling",
                      "icon": "mdi:snowflake",
                      "badge_icon": "mdi:fan",
                      "badge_color": "{% set s = states('sensor.ntk_ryansoffice_3dprinter_cooling_fan_speed') | int(0) %} {% if s == 0 %}grey{% elif s < 30 %}blue{% elif s < 70 %}cyan{% else %}light-blue{% endif %}",
                      "icon_color": "{% set s = states('sensor.ntk_ryansoffice_3dprinter_cooling_fan_speed') | int(0) %} {% if s == 0 %}grey{% elif s < 30 %}blue{% elif s < 70 %}cyan{% else %}light-blue{% endif %}",
                      "layout": "vertical",
                      "fill": false,
                      "multiline_secondary": false,
                      "tap_action": {
                        "action": "more-info",
                        "entity": "fan.ntk_ryansoffice_3dprinter_cooling_fan"
                      },
                      "hold_action": {
                        "action": "more-info",
                        "entity": "sensor.ntk_ryansoffice_3dprinter_cooling_fan_speed"
                      },
                      "card_mod": {
                        "style": "ha-card {\n  padding: 4px 4px !important;\n  background: transparent;\n  border-radius: 12px;\n  transition: background 0.2s;\n  --icon-size: 28px;\n  --card-primary-font-size: 1.1rem;\n  --card-primary-font-weight: bold;\n  --card-secondary-font-size: 0.65rem;\n}\nha-card:hover {\n  background: rgba(var(--rgb-primary-text-color), 0.05);\n}\nmushroom-state-info {\n  text-align: center;\n  --card-secondary-letter-spacing: 0.5px;\n}\n"
                      }
                    },
                    {
                      "type": "custom:mushroom-template-card",
                      "entity": "fan.3dprinter_controller_box_bento_box_fan",
                      "primary": "{% if states('fan.3dprinter_controller_box_bento_box_fan') == 'on' %}\n  {{ state_attr('fan.3dprinter_controller_box_bento_box_fan', 'percentage') | int(0) }}%\n{% elif states('fan.3dprinter_controller_box_bento_box_fan') == 'off' %}\n  Off\n{% else %}\n  N/A\n{% endif %}",
                      "secondary": "Bento",
                      "icon": "mdi:air-filter",
                      "badge_icon": "mdi:fan",
                      "badge_color": "{% set state = states('fan.3dprinter_controller_box_bento_box_fan') %}\n{% if state == 'off' or state in ['unavailable', 'unknown'] %}\n  grey\n{% else %}\n  {% set s = state_attr('fan.3dprinter_controller_box_bento_box_fan', 'percentage') | int(0) %}\n  {% if s < 30 %}green{% elif s < 70 %}amber{% else %}orange{% endif %}\n{% endif %}",
                      "icon_color": "{% set state = states('fan.3dprinter_controller_box_bento_box_fan') %}\n{% if state == 'off' or state in ['unavailable', 'unknown'] %}\n  grey\n{% else %}\n  {% set s = state_attr('fan.3dprinter_controller_box_bento_box_fan', 'percentage') | int(0) %}\n  {% if s < 30 %}green{% elif s < 70 %}amber{% else %}orange{% endif %}\n{% endif %}",
                      "layout": "vertical",
                      "fill": false,
                      "multiline_secondary": false,
                      "tap_action": {
                        "action": "more-info",
                        "entity": "fan.3dprinter_controller_box_bento_box_fan"
                      },
                      "hold_action": {
                        "action": "more-info",
                        "entity": "fan.3dprinter_controller_box_bento_box_fan"
                      },
                      "card_mod": {

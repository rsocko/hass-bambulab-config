                    {% set s = state_attr('fan.3dprinter_controller_box_bento_box_fan', 'percentage') | int(0) %}
                    {% if s < 30 %}green{% elif s < 70 %}amber{% else %}orange{% endif %}
                  {% endif %}
                icon_color: |
                  {% set state = states('fan.3dprinter_controller_box_bento_box_fan') %}
                  {% if state == 'off' or state in ['unavailable', 'unknown'] %}
                    grey
                  {% else %}
                    {% set s = state_attr('fan.3dprinter_controller_box_bento_box_fan', 'percentage') | int(0) %}
                    {% if s < 30 %}green{% elif s < 70 %}amber{% else %}orange{% endif %}
                  {% endif %}

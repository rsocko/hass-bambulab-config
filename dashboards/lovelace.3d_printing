                          "name": "[[[\n  const tray = 'ams_2_tray_1';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  return map?.[tray]?.name ?? 'EMPTY';\n]]]\n",
                          "label": "[[[\n  const tray = 'ams_2_tray_1';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  return map?.[tray]?.reason ?? '';\n]]]\n",
                          "show_state": false,
                          "show_icon": false,
                          "show_label": true,
                          "tap_action": "[[[\n  const tray = 'ams_2_tray_1';\n  const trayEntity = 'sensor.p1s_01p00c460102350_ams_2_tray_1';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  const spoolId = map?.[tray]?.spool_id;\n  const trayData = map?.[tray];\n\n  return {\n    action: 'fire-dom-event',\n    browser_mod: {\n      service: 'browser_mod.popup',\n      data: {\n        title: trayData?.name || 'AMS Tray Details',\n        content: {\n          type: 'vertical-stack',\n          cards: [\n            // Spool/Tray Info Header\n            {\n              type: 'custom:mushroom-template-card',\n              primary: trayData?.name || 'No Spool Matched',\n              secondary: spoolId ? `Spool ID: ${spoolId}` : `Tray: ${tray.replace('_', ' ').toUpperCase()}`,\n              icon: 'mdi:printer-3d-nozzle',\n              icon_color: trayData?.status === 'empty' ? 'disabled' : 'primary',\n              fill_container: false,\n              card_mod: {\n                style: `\n                  ha-card {\n                    background: ${trayData?.color ? '#' + trayData.color + '20' : 'var(--ha-card-background)'};\n                  }\n                `\n              }\n            },\n            // Material and Vendor Info\n            spoolId ? {\n              type: 'horizontal-stack',\n              cards: [\n                {\n                  type: 'custom:mushroom-template-card',\n                  primary: states['sensor.spoolman_spool_' + spoolId]?.attributes?.filament_material || 'Unknown',\n                  secondary: 'Material',\n                  icon: 'mdi:texture-box',\n                  icon_color: 'orange',\n                  fill_container: false\n                },\n                {\n                  type: 'custom:mushroom-template-card',\n                  primary: states['sensor.spoolman_spool_' + spoolId]?.attributes?.filament_vendor_name || 'Unknown',\n                  secondary: 'Vendor',\n                  icon: 'mdi:factory',\n                  icon_color: 'purple',\n                  fill_container: false\n                }\n              ]\n            } : null,\n            // Color and Icon Display\n            spoolId ? {\n              type: 'horizontal-stack',\n              cards: [\n                {\n                  type: 'custom:button-card',\n                  name: 'Filament Color',\n                  show_state: false,\n                  show_icon: true,\n                  icon: 'mdi:palette',\n                  styles: {\n                    card: [{\n                      'background': trayData?.color ? '#' + trayData.color : '#cccccc',\n                      'height': '80px'\n                    }],\n                    name: [{\n                      'color': trayData?.color ? (parseInt(trayData.color.substring(0,2), 16) + parseInt(trayData.color.substring(2,4), 16) + parseInt(trayData.color.substring(4,6), 16)) / 3 > 128 ? '#000' : '#fff' : '#000'\n                    }],\n                    icon: [{\n                      'color': trayData?.color ? (parseInt(trayData.color.substring(0,2), 16) + parseInt(trayData.color.substring(2,4), 16) + parseInt(trayData.color.substring(4,6), 16)) / 3 > 128 ? '#000' : '#fff' : '#000'\n                    }]\n                  }\n                },\n                {\n                  type: 'custom:mushroom-template-card',\n                  primary: `${states['sensor.spoolman_spool_' + spoolId]?.attributes?.remaining_weight || 'N/A'}g`,\n                  secondary: 'Remaining',\n                  icon: 'mdi:weight-gram',\n                  icon_color: 'blue',\n                  fill_container: false\n                }\n              ]\n            } : null,\n            // Desiccant Status and Reset\n            spoolId && trayData?.desiccant ? {\n              type: 'vertical-stack',\n              cards: [\n                {\n                  type: 'custom:mushroom-template-card',\n                  primary: 'Desiccant Status',\n                  secondary: trayData?.filled ? `Filled: ${new Date(trayData.filled).toLocaleDateString()}` : 'Not Set',\n                  icon: 'mdi:water',\n                  icon_color: trayData?.status === 'green' ? 'green' : trayData?.status === 'yellow' ? 'yellow' : trayData?.status === 'orange' ? 'orange' : trayData?.status === 'red' ? 'red' : 'disabled',\n                  fill_container: false\n                },\n                {\n                  type: 'custom:button-card',\n                  name: 'Reset Desiccant Date',\n                  icon: 'mdi:update',\n                  tap_action: {\n                    action: 'call-service',\n                    service: 'spoolman.patch_spool',\n                    service_data: {\n                      spool_id: spoolId,\n                      extra: {\n                        desiccant_filled: new Date().toISOString()\n                      }\n                    },\n                    confirmation: {\n                      text: 'Reset desiccant filled date to now?'\n                    }\n                  },\n                  styles: {\n                    card: [{ 'height': '50px' }]\n                  }\n                }\n              ]\n            } : null,\n            // Spoolman Link\n            spoolId ? {\n              type: 'custom:button-card',\n              name: 'Open in Spoolman',\n              icon: 'mdi:open-in-new',\n              tap_action: {\n                action: 'url',\n                url_path: `http://homeassistant.local:7912/spools/${spoolId}`\n              },\n              styles: {\n                card: [{ 'height': '50px' }],\n                name: [{ 'color': 'var(--primary-color)' }]\n              }\n            } : null,\n            // Weight History Chart (Dynamic Duration)\n            spoolId ? (() => {\n              const spoolEntity = states['sensor.spoolman_spool_' + spoolId];\n              const firstUsed = spoolEntity?.attributes?.first_used;\n              let historyHours = 168; // Default 7 days\n              \n              if (firstUsed) {\n                const firstUsedDate = new Date(firstUsed);\n                const now = new Date();\n                const daysSinceOpened = Math.floor((now - firstUsedDate) / (1000 * 60 * 60 * 24));\n                \n                // Show full history since opened, with reasonable limits\n                if (daysSinceOpened <= 7) {\n                  historyHours = daysSinceOpened * 24 || 24; // At least 1 day\n                } else if (daysSinceOpened <= 30) {\n                  historyHours = daysSinceOpened * 24;\n                } else if (daysSinceOpened <= 90) {\n                  historyHours = daysSinceOpened * 24;\n                } else {\n                  historyHours = daysSinceOpened * 24; // Show full history\n                }\n              }\n              \n              return {\n                type: 'history-graph',\n                title: firstUsed ? `Weight History (${Math.floor(historyHours / 24)} days)` : 'Weight History',\n                entities: [\n                  {\n                    entity: `sensor.spoolman_spool_${spoolId}`,\n                    name: 'Remaining Weight'\n                  }\n                ],\n                hours_to_show: historyHours\n              };\n            })() : null,\n            // AMS Tray Raw Data (when no spool matched)\n            !spoolId ? {\n              type: 'entities',\n              title: 'AMS Tray Information',\n              entities: [\n                {\n                  entity: trayEntity,\n                  name: 'Tray Entity'\n                }\n              ]\n            } : null,\n            // More Info Button\n            spoolId ? {\n              type: 'custom:button-card',\n              name: 'More Details',\n              icon: 'mdi:information',\n              tap_action: {\n                action: 'more-info',\n                entity: `sensor.spoolman_spool_${spoolId}`\n              },\n              styles: {\n                card: [{ 'height': '50px' }]\n              }\n            } : null\n          ].filter(card => card !== null)\n        }\n      }\n    }\n  };\n]]]\n",
                          "custom_fields": {
                            "desiccant_icon": "[[[\n  const tray = 'ams_2_tray_1';\n  const status = states['sensor.spoolman_tray_map']?.attributes?.tray_map?.[tray]?.status;\n\n  // Hide droplet for green OR empty trays\n  if (status === 'green' || status === 'empty') return '';\n\n  const colors = {\n    undefined: '#9e9e9e',\n    yellow: '#ffcc00',\n    orange: '#ff9900',\n    red: '#cc0000'\n  };\n  \n  const color = colors[status] || '#9e9e9e';\n  return `<ha-icon icon=\"mdi:water\" style=\"--mdc-icon-size: 16px; color: ${color};\"></ha-icon>`;\n]]]\n",
                            "remaining_weight": "[[[\n  const tray = 'ams_2_tray_1';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  const spoolId = map?.[tray]?.spool_id;\n  \n  if (!spoolId) return '';\n  \n  const spoolentity = states[`sensor.spoolman_spool_${spoolId}`];\n  const weight = spoolentity?.attributes?.remaining_weight;\n  \n  if (weight === undefined || weight === null) return '';\n  \n  return `<span style=\"font-size: 10px; color: #888;\">${Math.round(weight)}g</span>`;\n]]]\n",
                            "print_weight": "[[[\n  const tray = 'ams_2_tray_1';\n  const map = states['sensor.spoolman_tray_map']?.attributes?.tray_map;\n  const spoolId = map?.[tray]?.spool_id;\n  \n  // Only show if tray has a spool mapped\n  if (!spoolId) return '';\n  \n  // Get print weight from sensor attributes\n  const printWeightEntity = states['sensor.ntk_ryansoffice_3dprinter_print_weight'];\n  const printWeight = printWeightEntity?.attributes?.['AMS 2 Tray 1'];\n  \n  if (!printWeight || printWeight === 0) return '';\n  \n  // Get remaining weight for color coding\n  const spoolentity = states[`sensor.spoolman_spool_${spoolId}`];\n  const remainingWeight = spoolentity?.attributes?.remaining_weight;\n  \n  // Determine color based on remaining vs print weight\n  let color = '#888'; // default\n  if (remainingWeight !== undefined && remainingWeight !== null) {\n    if (remainingWeight < printWeight) {\n      color = '#cc0000'; // red - will run out\n    } else if (remainingWeight < printWeight * 1.1) {\n      color = '#ff9900'; // orange - close\n    } else if (remainingWeight < printWeight * 1.2) {\n      color = '#ffcc00'; // yellow - approaching\n    }\n  }\n  \n  return `<span style=\"font-size: 10px; color: ${color}; font-weight: ${color !== '#888' ? '600' : '400'};\">(−${printWeight.toFixed(1)}g)</span>`;\n]]]\n",
                            "placeholder": "[[[\n  return '';\n]]]\n"
                          },
                          "styles": "[[[\n  const tray = 'ams_2_tray_1';\n  const activeTrayState = states['sensor.ntk_ryansoffice_3dprinter_active_tray']?.state;\n  const isActive = activeTrayState === '5';\n  \n  // Use cyan border color (matching Bambu AMS card)\n  const borderColor = '#2196F3';\n  \n  return {\n    card: [\n      { 'padding': '6px' },\n      { 'background': 'none' },\n      { 'box-shadow': 'none' },\n      ...(isActive ? [{ 'border': `3px solid ${borderColor}` }, { 'border-radius': '8px' }] : [])\n    ],
                            grid: [
                              {
                                "grid-template-areas": "\"n n n\" \"l l l\" \"desiccant_icon . remaining_weight\" \". . print_weight\""
                              },
                              {
                                "grid-template-columns": "auto 1fr auto"
                              },
                              {
                                "grid-template-rows": "auto auto auto auto"
                              }
                            ],
                            name: [
                              {
                                "font-size": "12px"
                              },
                              {
                                "white-space": "normal"
                              },
                              {
                                "line-height": 1.2
                              },
                              {
                                "justify-self": "center"
                              },
                              {
                                "padding-bottom": "2px"
                              }
                            ],
                            label: [
                              {
                                "font-size": "9px"
                              },
                              {
                                "color": "#888"
                              },
                              {
                                "font-style": "italic"
                              },
                              {
                                "white-space": "normal"
                              },
                              {
                                "line-height": 1.1
                              },
                              {
                                "justify-self": "center"
                              },
                              {
                                "padding-bottom": "4px"
                              }
                            ],
                            custom_fields: {
                              desiccant_icon: [
                                {
                                  "justify-self": "start"
                                },
                                {
                                  "padding-left": "4px"
                                }
                              ],
                              remaining_weight: [
                                {
                                  "justify-self": "end"
                                },
                                {
                                  "padding-right": "4px"
                                }
                              ],
                              print_weight: [
                                {
                                  "justify-self": "end"
                                },
                                {
                                  "padding-right": "4px"
                                }
                              ]
                            }
                          };
]]]\n"
                        }
                      ]

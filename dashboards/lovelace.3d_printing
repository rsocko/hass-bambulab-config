          </div>
  - type: custom:vertical-layout
    path: spool
    icon: fapro:filament-2
    cards:
      - type: custom:bubble-card
        card_type: separator
        sub_button:
          main: []
          bottom: []
        name: Spool Information
        icon: fapro:filament-2
        card_layout: large
      - type: custom:config-template-card
        variables:
          selected_entity: states['sensor.selected_spool'].state
        entities:
          - sensor.selected_spool
        card:
          type: custom:bubble-card
          card_type: button
          button_type: state
          entity: ${selected_entity}
          icon: ''
          name: ''
          show_icon: true
          show_attribute: false
          show_state: false
          scrolling_effect: true
          rows: 1.719
          styles: |
            /* Global bump */ 
            * { 
              font-size: 18px !important; 
            } 

            /* Main entity name */ 
            .bubble-name { 
              font-size: 22px !important; 
              font-weight: 700; 
            } 

            /* Top location attribute */ 
            .bubble-sub-button-main .bubble-sub-button-text { 
              font-size: 22px !important; 
              font-weight: 600; 
            } 

            /* Bottom ID label */ 
            .bubble-sub-button-bottom .bubble-sub-button-text, .bubble-state { 
              font-size: 16px !important; 
              font-weight: 600; 
            }
          sub_button:
            main: []
            bottom:
              - entity: ${selected_entity}
                icon: fas:location-dot
                show_background: true
                state_background: false
                show_icon: true
                show_attribute: true
                attribute: location
              - entity: ${selected_entity}

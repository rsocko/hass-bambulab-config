            {
              "type": "horizontal-stack",
              "cards": [
                {
                  "type": "custom:button-card",
                  "show_icon": true,
                  "show_name": false,
                  "show_label": true,
                  "tap_action": {
                    "action": "none"
                  },
                  "hold_action": {
                    "action": "none"
                  },
                  "double_tap_action": {
                    "action": "none"
                  },
                  "icon": "mdi:water",
                  "label": "[[[\n  const selected_entity = states['sensor.selected_spool'].state;\n  const spool_id = states[selected_entity].attributes.id;\n  const spool_entity = states[selected_entity];\n\n  const date = spool_entity?.attributes?.extra_desiccant_filled;\n  if (!date) return '—';\n\n  const filled = new Date(date);\n  const now = new Date();\n  const days = Math.floor((now - filled) / 86400000);\n\n  let ago;\n  if (days < 7) ago = `${days}d ago`;\n  else if (days < 30) ago = `${Math.floor(days / 7)}w ago`;\n  else ago = `${Math.floor(days / 30)}mo ago`;\n\n  return `${filled.toLocaleDateString('en-US')} (${ago})`;\n]]]\n",
                  "styles": {
                    "grid": [
                      {
                        "grid-template-areas": "\"i\" \"l\""
                      },
                      {
                        "grid-template-rows": "min-content min-content"
                      },
                      {
                        "justify-items": "center"
                      },
                      {
                        "align-items": "center"
                      }
                    ],
                    "card": [
                      {
                        "background": "none"
                      },
                      {
                        "box-shadow": "none"
                      },
                      {
                        "padding": "4px"
                      }
                    ],
                    "icon": [
                      {
                        "width": "25px"
                      },
                      {
                        "height": "25px"
                      },
                      {
                        "margin-bottom": "2px"
                      },
                      {
                        "color": "[[[\n  const selected_entity = states['sensor.selected_spool'].state;\n  const spool_id = states[selected_entity].attributes.id;\n  const spool_entity = states[selected_entity];\n\n  const date = spool_entity?.attributes?.extra_desiccant_filled;\n  if (!date) return 'gray';\n\n  const months = ((Date.now() - new Date(date)) / 86400000) / 30.437;\n  if (months > 2.5) return 'red';\n  if (months > 2.0) return 'orange';\n  if (months > 1.5) return 'yellow';\n  return 'green';\n]]]\n"
                      }
                    ],
                    "label": [
                      {
                        "font-size": "14px"
                      },
                      {
                        "text-align": "center"
                      },
                      {
                        "white-space": "nowrap"
                      }
                    ]
                  }
                },
                {

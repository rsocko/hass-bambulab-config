                          "styles": "[[[\n  const tray = 'ams_2_tray_4';\n  const activeTrayState = states['sensor.ntk_ryansoffice_3dprinter_active_tray']?.state;\n  const isActive = activeTrayState === '8';\n  \n  // Use cyan border color (matching Bambu AMS card)\n  const borderColor = '#2196F3';\n  \n  return {\n    card: [\n      { 'padding': '6px' },\n      { 'background': 'none' },\n      { 'box-shadow': 'none' },\n      ...(isActive ? [{ 'border': `3px solid ${borderColor}` }, { 'border-radius': '8px' }] : [])\n    ],
                            grid: [
                              {
                                "grid-template-areas": "\"n n n\" \"l l l\" \"desiccant_icon . remaining_weight\" \". . print_weight\""

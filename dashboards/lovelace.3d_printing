                  "theme": "Metro Blue",
                  "card_mod": {
                    "style": "ha-card {\n  width: 70px;       /* icon-sized */\n  height: 55px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\nha-icon {\n  width: 48px;\n  height: 48px;\n}\n"
                  }

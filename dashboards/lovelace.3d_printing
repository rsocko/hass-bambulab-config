                tap_action:
                  action: more-info
                  entity: fan.3dprinter_controller_box_bento_box_fan
                hold_action:
                  action: more-info
                  entity: fan.3dprinter_controller_box_bento_box_fan
                card_mod:
                  style: |
                    ha-card {
                      padding: 4px 4px !important;
                      background: transparent;

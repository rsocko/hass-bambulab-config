            },
            {
              "type": "custom:config-template-card",
              "variables": {
                "selected_entity": "states['sensor.selected_spool'].state"
              },
              "entities": [
                "sensor.selected_spool"
              ],
              "card": {
                "type": "custom:bubble-card",
                "card_type": "button",
                "button_type": "state",
                "entity": "${selected_entity}",
                "icon": "",
                "name": "",
                "show_icon": true,
                "show_attribute": false,
                "show_state": false,
                "scrolling_effect": true,
                "rows": 1.719,
                "styles": "/* Global bump */ \n* { \n  font-size: 18px !important; \n} \n\n/* Main entity name */ \n.bubble-name { \n  font-size: 22px !important; \n  font-weight: 700; \n} \n\n/* Top location attribute */ \n.bubble-sub-button-main .bubble-sub-button-text { \n  font-size: 22px !important; \n  font-weight: 600; \n} \n\n/* Bottom ID label */ \n.bubble-sub-button-bottom .bubble-sub-button-text, .bubble-state { \n  font-size: 16px !important; \n  font-weight: 600; \n}\n",
                "sub_button": {
                  "main": [],
                  "bottom": [
                    {
                      "entity": "${selected_entity}",
                      "icon": "fas:location-dot",
                      "show_background": true,
                      "state_background": false,
                      "show_icon": true,
                      "show_attribute": true,
                      "attribute": "location"
                    },
                    {
                      "entity": "${selected_entity}",
                      "icon": "mdi:weight-gram",
                      "state_background": false,
                      "show_state": true
                    }
                  ]
                }
              }
            },
            {
              "type": "custom:bubble-card",
              "card_type": "separator",
              "sub_button": {
                "main": [],
                "bottom": []
              },
              "name": "Change Location",
              "icon": "mdi:map-marker-distance",
              "card_layout": "large"
            },
            {
              "type": "custom:config-template-card",
              "entities": [
                "sensor.selected_spool"
              ],
              "variables": {
                "selected_entity": "states['sensor.selected_spool'].state",
                "spool_id": "states[states['sensor.selected_spool'].state].attributes.id"
              },
              "card": {
                "type": "custom:bubble-card",
                "card_type": "sub-buttons",
                "entity": "${selected_entity}",
                "hide_main_background": false,
                "rows": 0.938,
                "sub_button": {
                  "main": [],
                  "bottom": [
                    {
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.update_spool_location",
                        "target": {},
                        "data": {
                          "spool_id": "${ spool_id }",
                          "location": "AMS"
                        }
                      },
                      "name": "AMS",
                      "show_name": true,
                      "icon": "fas:arrow-right-to-bracket",
                      "show_state": false,
                      "state_background": false
                    },
                    {
                      "tap_action": {
                        "action": "perform-action",
                        "perform_action": "script.update_spool_location",
                        "target": {},

            bottom:
              - tap_action:
                  action: perform-action
                  perform_action: script.update_spool_location
                  target: {}
                  data:
                    spool_id: ${ spool_id }
                    location: AMS
                name: AMS
                show_name: true
                icon: fas:arrow-right-to-bracket
                show_state: false
                state_background: false
              - tap_action:
                  action: perform-action
                  perform_action: script.update_spool_location
                  target: {}
                  data:
                    spool_id: ${ spool_id }
                    location: AMS 2
                name: AMS 2
                show_name: true
                icon: fas:arrow-right-to-bracket
                show_state: false
                state_background: false
      - type: custom:layout-card
        layout_type: custom:grid-layout
        layout:
          grid-template-columns: 1fr auto
          grid-gap: 12px
        cards:
          - type: entities
            entities:
              - entity: input_select.spool_location_choice
                name: 'Move to:'
                secondary_info: none
            theme: Metro Blue
            card_mod:
              style: |
                ha-card {
                  font-size: 1.4rem;
                }
          - show_name: false
            show_icon: true
            type: button
            icon: mdi:refresh-circle
            name: ''
            tap_action:
              action: perform-action
              perform_action: automation.trigger
              target:
                entity_id: automation.spoolman_location_sync
              data:
                skip_condition: true
            show_state: false
            theme: Metro Blue
